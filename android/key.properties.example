# Copy to key.properties (never commit key.properties) and set real values.
# Generate a keystore once (from android/):
#   keytool -genkey -v -keystore app/upload-keystore.jks -storetype JKS -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# storeFile is relative to the android/ directory (see app/build.gradle.kts).

storePassword=your-store-password
keyPassword=your-key-password
keyAlias=upload
storeFile=app/upload-keystore.jks
